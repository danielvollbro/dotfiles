{
	"layer": "top",
	"position": "top",
	"height": 30,
	"modules-left": ["hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["pulseaudio", "network", "battery", "tray"],

	"hyprland/workspace": {
		"format": "{icon}",
		"format-icons": {
			"default": "o",
			"active": "+"
		}
	},
	"clock": {
		"format": " {:%H:%M %d/%m}"
	},
	"battery": {
		"format": "{capacity}% {icon}",
		"format-icons": ["", "", "", "", ""]
	},
	"network": {
		"format-wifi": " {essid} ({signalStrength}%) ",
		"format-disconnected": "󰤮 No signal"
	},
	"pulseaudio": {
		"format": " {volume}% "
	},
	"tray": {
		"spacing": 10
	}
}
